# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pvjewelleryshop?retryWrites=true&w=majority

# JWT Secrets (Must use strong random strings in production)
JWT_ACCESS_SECRET=your_production_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (Vercel deployment URL for CORS)
FRONTEND_URL=https://pvjewellery.vercel.app

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary Integration (Persistent Image Uploads on Render)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer - Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@pvjewelleryshop.com
